# 3D A-B diblock copolymer (f = 0.5, large chi*N) that forms a
# (defective) lamellar state from a random initial configuration.
box ps
Dim 3
grid 35 35 35

logFreq 2500
gsdFreq 5000
fieldFreq 5000
pmeorder 1

species A
species B

bond 1 harmonic 1.5 0.0

# readData must precede the integrator (integrators allocate from nstot).
readData input.data

integrator all GJF delt 0.005

potential gaussian A A 1.5625 1.0
potential gaussian B B 1.5625 1.0
potential gaussian A B 3.5 1.0
endBox

run nvt 2000001
